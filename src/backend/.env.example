PORT=3000
DATABASE_URL=postgres://cafestock:cafestock@localhost:5432/cafestock

# Browser origin(s) allowed to call the API (comma-separated). Vite dev server by default.
CORS_ORIGIN=http://localhost:5173

# Authentication. There is no default: the API refuses to start unless AUTH_MODE is set.
#
# local   - development/testing. Tokens are minted with `npm run token -- staff|manager`
#           and signed with AUTH_LOCAL_SECRET (placeholder below; use your own, 32+ chars).
#           Refused when NODE_ENV=production.
# cognito - deployment. Tokens come from an Amazon Cognito user pool with groups
#           "staff" and "manager"; fill in the three COGNITO_* values.
AUTH_MODE=local
AUTH_LOCAL_SECRET=dev-only-placeholder-secret-change-me-0123456789
# AUTH_MODE=cognito
# COGNITO_REGION=us-east-1
# COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
# COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
