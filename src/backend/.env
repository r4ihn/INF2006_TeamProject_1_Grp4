# Copy this file to `.env` (same folder) and adjust as needed.
# `.env` is git-ignored — never commit real secrets.
# Every value below is also the built-in default, so the app works without a .env file.

# Port the API listens on
PORT=3000

# Comma-separated list of browser origins allowed to call the API (the Vite dev server)
CORS_ORIGIN=http://localhost:5173

# Local PostgreSQL started by `npm run db:up` (see docker-compose.yml — note port 5433)
DATABASE_URL=postgresql://cafestock:cafestock@localhost:5433/cafestock

# Database used by `npm test` — wiped and rebuilt on every test run. Must end in _test.
TEST_DATABASE_URL=postgresql://cafestock:cafestock@localhost:5433/cafestock_test

# Café that signed-in users join unless their Cognito account has custom:org set
DEMO_ORG_SLUG=demo-cafe

# ── Sign-in ──────────────────────────────────────────────────────────────────
# Leave these empty for development sign-in (pick staff/manager, no AWS needed).
# Fill them in from the CloudFormation stack outputs to use Amazon Cognito —
# see docs/cognito-setup.md.
COGNITO_USER_POOL_ID='us-east-1_QCVZzyeWe'
COGNITO_CLIENT_ID='69nqf90aejekeiqtn8ktfm8po6'
# Optional: force a mode ("dev" or "cognito"). Default: cognito if both ids are set.
# AUTH_MODE=
