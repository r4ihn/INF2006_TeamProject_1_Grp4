// CafeStock database schema (PostgreSQL).
//
// Conventions
// - Models are PascalCase in TypeScript, tables/columns are snake_case in Postgres
//   (@@map / @map), so the Python forecast Lambda can use natural SQL names.
// - Every business table has a required `org_id` → organizations.id (multi-tenant ready).
// - Child → parent links include org_id in a composite foreign key, e.g.
//   items(supplier_id, org_id) → suppliers(id, org_id). The database itself refuses an
//   item that points at another organisation's supplier.
// - IDs (gen_random_uuid()) and created_at (now()) are generated by Postgres, not by
//   Prisma, so rows inserted by the Python Lambda get them too.
// - Quantities are NUMERIC(12,3) (e.g. 2.5 kg of beans); money is NUMERIC(10,2).
// - CHECK constraints (non-negative quantities etc.) are added by hand at the end of
//   the first migration — Prisma's schema language can't express them.
//
// The forecast tables (forecast_runs, forecasts, reorder_recommendations) are the
// contract with the Python Lambda — see docs/data-contract.md before changing them.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "js"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// ─── Tenancy & users ────────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String   @unique
  timezone  String   @default("Asia/Singapore")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  users                  User[]
  suppliers              Supplier[]
  items                  Item[]
  inventoryMovements     InventoryMovement[]
  demandHistory          DemandHistory[]
  datasetImports         DatasetImport[]
  forecastRuns           ForecastRun[]
  forecasts              Forecast[]
  reorderRecommendations ReorderRecommendation[]

  @@map("organizations")
}

enum UserRole {
  STAFF
  MANAGER

  @@map("user_role")
}

model User {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  /// Cognito "sub" claim — linked on first login (Task 6)
  cognitoSub  String?  @unique @map("cognito_sub")
  email       String
  displayName String?  @map("display_name")
  role        UserRole @default(STAFF)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  org       Organization        @relation(fields: [orgId], references: [id], onDelete: Restrict)
  movements InventoryMovement[]

  @@unique([orgId, email])
  @@unique([id, orgId])
  @@map("users")
}

// ─── Inventory ──────────────────────────────────────────────────────────────

model Supplier {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  name         String
  contactName  String?  @map("contact_name")
  email        String?
  phone        String?
  /// Days between placing an order and receiving it — drives safety stock & reorder point
  leadTimeDays Int      @default(2) @map("lead_time_days")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  items Item[]

  @@unique([orgId, name])
  @@unique([id, orgId])
  @@map("suppliers")
}

model Item {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  supplierId   String?  @map("supplier_id") @db.Uuid
  sku          String?
  name         String
  category     String
  /// Unit of measure, e.g. "kg", "L", "pcs", "box"
  unit         String
  /// Up to 4 decimals: ingredients are often costed per g or ml (milk ≈ S$0.0021/ml)
  unitCost     Decimal  @default(0) @map("unit_cost") @db.Decimal(12, 4)
  /// Current stock level. Only changed together with an inventory_movements row (Task 5).
  onHand       Decimal  @default(0) @map("on_hand") @db.Decimal(12, 3)
  /// Manual reorder point; the forecast computes its own in reorder_recommendations
  reorderPoint Decimal  @default(0) @map("reorder_point") @db.Decimal(12, 3)
  /// Max quantity worth holding before it spoils; caps recommended order qty. NULL = no cap
  spoilageCap  Decimal? @map("spoilage_cap") @db.Decimal(12, 3)
  /// Soft delete: inactive items keep their history but disappear from lists
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  /// Composite FK keeps the supplier in the same org. Deleting a supplier that still has
  /// items is refused — reassign or deactivate the items first.
  supplier Supplier?    @relation(fields: [supplierId, orgId], references: [id, orgId], onDelete: Restrict)

  movements              InventoryMovement[]
  demandHistory          DemandHistory[]
  forecasts              Forecast[]
  reorderRecommendations ReorderRecommendation[]

  @@unique([orgId, name])
  @@unique([orgId, sku])
  @@unique([id, orgId])
  @@index([orgId, supplierId])
  @@map("items")
}

enum MovementType {
  /// Stock delivered by a supplier (+)
  RECEIVE
  /// Consumed in normal operations (−) — this is "demand"
  USAGE
  /// Spoiled / thrown away (−)
  WASTE
  /// Manual correction (±)
  ADJUSTMENT
  /// Physical stock count; quantity_change = counted − previous on_hand (±)
  COUNT

  @@map("movement_type")
}

/// Append-only ledger of every stock change. items.on_hand is the running total.
model InventoryMovement {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String       @map("org_id") @db.Uuid
  itemId         String       @map("item_id") @db.Uuid
  type           MovementType
  /// Signed change: +10 received, −3 used
  quantityChange Decimal      @map("quantity_change") @db.Decimal(12, 3)
  /// items.on_hand right after this movement
  quantityAfter  Decimal      @map("quantity_after") @db.Decimal(12, 3)
  note           String?
  occurredAt     DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(3)
  createdById    String?      @map("created_by_id") @db.Uuid
  /// Set when the row came from a dataset's stock ledger (Task 7) rather than the app
  importId       String?      @map("import_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  org           Organization   @relation(fields: [orgId], references: [id], onDelete: Restrict)
  item          Item           @relation(fields: [itemId, orgId], references: [id, orgId], onDelete: Restrict)
  createdBy     User?          @relation(fields: [createdById, orgId], references: [id, orgId], onDelete: Restrict)
  datasetImport DatasetImport? @relation(fields: [importId, orgId], references: [id, orgId], onDelete: Restrict)

  @@index([orgId, itemId, occurredAt])
  @@index([orgId, importId])
  @@map("inventory_movements")
}

enum DemandSource {
  /// Loaded from the historical dataset (Task 7)
  IMPORT
  /// Aggregated from USAGE movements recorded in the app (Task 5)
  MOVEMENTS

  @@map("demand_source")
}

/// One row per item per day — the time series the forecast is trained and run on.
model DemandHistory {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String       @map("org_id") @db.Uuid
  itemId    String       @map("item_id") @db.Uuid
  date      DateTime     @db.Date
  quantity  Decimal      @db.Decimal(12, 3)
  source    DemandSource
  /// For IMPORT rows: the import run that last wrote this row (dataset provenance)
  importId  String?      @map("import_id") @db.Uuid
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  org           Organization   @relation(fields: [orgId], references: [id], onDelete: Restrict)
  item          Item           @relation(fields: [itemId, orgId], references: [id, orgId], onDelete: Restrict)
  datasetImport DatasetImport? @relation(fields: [importId, orgId], references: [id, orgId], onDelete: Restrict)

  @@unique([orgId, itemId, date])
  @@index([orgId, importId])
  @@map("demand_history")
}

/// Provenance of every dataset import run (Task 7): where the data came from, which files
/// (with checksums), the date range, and what the run changed. Every run adds a row.
model DatasetImport {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId              String   @map("org_id") @db.Uuid
  /// Where the data came from, in words
  source             String
  /// [{ role, file, rows, sha256, columns }] for every file read
  files              Json
  itemCount          Int      @map("item_count")
  dayCount           Int      @map("day_count")
  /// First and last demand date written (after any shift)
  dateFrom           DateTime @map("date_from") @db.Date
  dateTo             DateTime @map("date_to") @db.Date
  /// Days added to every date so the history ends recently (0 = the dataset's real dates)
  dateShiftDays      Int      @default(0) @map("date_shift_days")
  itemsCreated       Int      @map("items_created")
  /// Daily demand rows: new, changed, already identical, skipped (the app recorded that day)
  demandInserted     Int      @map("demand_inserted")
  demandUpdated      Int      @map("demand_updated")
  demandUnchanged    Int      @map("demand_unchanged")
  demandSkipped      Int      @map("demand_skipped")
  /// Stock ledger rows added, and items whose ledger was left alone
  movementsInserted  Int      @map("movements_inserted")
  ledgerItemsSkipped Int      @map("ledger_items_skipped")
  /// Earlier imported data was removed first (--replace)
  replaced           Boolean  @default(false)
  importedAt         DateTime @default(now()) @map("imported_at") @db.Timestamptz(3)

  org                Organization        @relation(fields: [orgId], references: [id], onDelete: Restrict)
  demandHistory      DemandHistory[]
  inventoryMovements InventoryMovement[]

  @@unique([id, orgId])
  @@index([orgId, importedAt(sort: Desc)])
  @@map("dataset_imports")
}

// ─── Forecasting (written by the Python Lambda, read by the API) ────────────

enum ModelKind {
  /// Trained LightGBM model loaded from S3
  ML
  /// Moving-average / exponential-smoothing baseline (Task 8)
  BASELINE

  @@map("model_kind")
}

enum RunStatus {
  RUNNING
  SUCCEEDED
  FAILED

  @@map("run_status")
}

/// One nightly forecast job. Holds the run-level numbers the manager's KPI header shows.
model ForecastRun {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String    @map("org_id") @db.Uuid
  /// e.g. "lgbm-v3" or "baseline-ma14" — shown in the UI
  modelTag       String    @map("model_tag")
  modelKind      ModelKind @map("model_kind")
  /// true when the ML model was unavailable and the baseline was used instead
  isFallback     Boolean   @default(false) @map("is_fallback")
  status         RunStatus @default(RUNNING)
  horizonDays    Int       @default(7) @map("horizon_days")
  /// Hold-out MAPE of the model and of the baseline, as fractions (0.164 = 16.4%)
  mapeModel      Decimal?  @map("mape_model") @db.Decimal(6, 4)
  mapeBaseline   Decimal?  @map("mape_baseline") @db.Decimal(6, 4)
  /// Hold-out MASE (error ÷ error of "same day last week"; below 1 beats it) — the headline
  maseModel      Decimal?  @map("mase_model") @db.Decimal(6, 4)
  maseBaseline   Decimal?  @map("mase_baseline") @db.Decimal(6, 4)
  /// The baseline it was compared with, e.g. "baseline-ma14"
  baselineTag    String?   @map("baseline_tag")
  /// Recent weeks the errors above were measured on
  evalWeeks      Int       @default(8) @map("eval_weeks")
  /// First forecast day; the history used ends the day before
  forecastFrom   DateTime  @default(dbgenerated("CURRENT_DATE")) @map("forecast_from") @db.Date
  /// Days an order is meant to cover after it arrives
  reviewDays     Int       @default(7) @map("review_days")
  /// Service-level factor used for safety stock (1.65 ≈ 95%)
  serviceLevelZ  Decimal   @default(1.65) @map("service_level_z") @db.Decimal(4, 2)
  /// Where the model came from, e.g. s3://bucket/models/lgbm-v3/model.txt
  modelUri       String?   @map("model_uri")
  itemsProcessed Int       @default(0) @map("items_processed")
  errorMessage   String?   @map("error_message")
  startedAt      DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(3)

  org                    Organization            @relation(fields: [orgId], references: [id], onDelete: Restrict)
  forecasts              Forecast[]
  reorderRecommendations ReorderRecommendation[]

  @@unique([id, orgId])
  @@index([orgId, startedAt(sort: Desc)])
  @@map("forecast_runs")
}

/// Predicted demand for one item on one future day, within one run.
model Forecast {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  runId        String   @map("run_id") @db.Uuid
  itemId       String   @map("item_id") @db.Uuid
  forecastDate DateTime @map("forecast_date") @db.Date
  predictedQty Decimal  @map("predicted_qty") @db.Decimal(12, 3)
  /// Confidence band for the chart (optional)
  lowerQty     Decimal? @map("lower_qty") @db.Decimal(12, 3)
  upperQty     Decimal? @map("upper_qty") @db.Decimal(12, 3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  /// Deleting a run deletes its forecast rows
  run  ForecastRun  @relation(fields: [runId, orgId], references: [id, orgId], onDelete: Cascade)
  item Item         @relation(fields: [itemId, orgId], references: [id, orgId], onDelete: Restrict)

  @@unique([runId, itemId, forecastDate])
  @@index([orgId, itemId, forecastDate])
  @@map("forecasts")
}

enum RecommendationStatus {
  /// Enough stock to cover lead-time demand plus safety stock
  OK
  /// Below the reorder point — order soon
  REORDER
  /// Expected to run out before a new delivery could arrive
  URGENT

  @@map("recommendation_status")
}

/// Per-item reorder maths for one run — also powers the "how this number was reached" panel.
model ReorderRecommendation {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId              String               @map("org_id") @db.Uuid
  runId              String               @map("run_id") @db.Uuid
  itemId             String               @map("item_id") @db.Uuid
  onHand             Decimal              @map("on_hand") @db.Decimal(12, 3)
  leadTimeDays       Int                  @map("lead_time_days")
  avgDailyDemand     Decimal              @map("avg_daily_demand") @db.Decimal(12, 3)
  /// σ of daily demand
  demandStdDev       Decimal              @map("demand_std_dev") @db.Decimal(12, 3)
  /// Sum of the daily forecast across the lead-time window
  leadTimeDemand     Decimal              @map("lead_time_demand") @db.Decimal(12, 3)
  /// Z × σ × √(lead time)
  safetyStock        Decimal              @map("safety_stock") @db.Decimal(12, 3)
  /// lead-time demand + safety stock
  reorderPoint       Decimal              @map("reorder_point") @db.Decimal(12, 3)
  /// max(0, reorder point − on hand)
  shortfall          Decimal              @db.Decimal(12, 3)
  /// Forecast demand over the review period after the lead time
  reviewDemand       Decimal              @default(0) @map("review_demand") @db.Decimal(12, 3)
  /// reorder point + review demand — what an order tops stock up to
  orderUpTo          Decimal              @default(0) @map("order_up_to") @db.Decimal(12, 3)
  /// Shortfall, capped by the item's spoilage cap
  recommendedQty     Decimal              @map("recommended_qty") @db.Decimal(12, 3)
  spoilageCapApplied Boolean              @default(false) @map("spoilage_cap_applied")
  /// on hand ÷ average daily demand (NULL when demand is 0)
  coverDays          Decimal?             @map("cover_days") @db.Decimal(8, 2)
  /// This item's forecast error on the hold-out window, as a fraction
  itemMape           Decimal?             @map("item_mape") @db.Decimal(6, 4)
  itemMase           Decimal?             @map("item_mase") @db.Decimal(6, 4)
  /// Days of demand history the forecast used
  historyDays        Int                  @default(0) @map("history_days")
  /// Caveats shown to the manager, e.g. "No supplier lead time: assumed 2 days."
  notes              String[]             @default([])
  status             RecommendationStatus
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  run  ForecastRun  @relation(fields: [runId, orgId], references: [id, orgId], onDelete: Cascade)
  item Item         @relation(fields: [itemId, orgId], references: [id, orgId], onDelete: Restrict)

  @@unique([runId, itemId])
  @@index([orgId, itemId])
  @@map("reorder_recommendations")
}
