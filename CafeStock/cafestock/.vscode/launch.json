{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug API (backend)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/src/backend",
      "runtimeArgs": ["--import", "tsx"],
      "program": "${workspaceFolder}/src/backend/src/server.ts",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    }
  ]
}
